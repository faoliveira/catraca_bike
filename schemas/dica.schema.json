{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catraca.bike/schemas/dica.schema.json",
  "title": "Dica de acessório Catraca",
  "type": "object",
  "properties": {
    "marca": {
      "type": "string",
      "minLength": 1,
      "description": "Como a marca escreve o próprio nome: 2C2 Bags, Magicshine, iGPSport."
    },
    "modelo": {
      "type": "string",
      "minLength": 1,
      "description": "O nome do produto sem a marca, com número e unidade separados (Drei Night 18 L). Produto sem nome de modelo leva o tipo em minúsculas (alforje 27 L)."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "capacete",
        "luz",
        "cadeado",
        "bomba",
        "ferramenta",
        "bolsa",
        "computador",
        "conforto",
        "outro"
      ],
      "description": "bolsa inclui alforje e mochila de bike; computador inclui computador de bordo, GPS e sensores; conforto inclui manopla, selim, canote e fita."
    },
    "subcategoria": {
      "description": "A prateleira dentro da categoria. Obrigatória em luz (farol, lanterna-traseira), bolsa (carga, kit-do-pedal), computador (computador-de-bordo, sensor) e conforto (manopla, selim, canote, fita); fora delas, tire o campo.",
      "type": "string",
      "enum": [
        "farol",
        "lanterna-traseira",
        "carga",
        "kit-do-pedal",
        "computador-de-bordo",
        "sensor",
        "manopla",
        "selim",
        "canote",
        "fita"
      ]
    },
    "papel": {
      "description": "Opcional. O selo da dica na prateleira; primeira-escolha vale para no máximo uma dica por prateleira.",
      "type": "string",
      "enum": [
        "primeira-escolha",
        "feito-no-brasil",
        "para-ebike"
      ]
    },
    "resumo": {
      "type": "string",
      "minLength": 1,
      "description": "A primeira frase diz o que é e por que vale a pena, em até 120 caracteres; as seguintes trazem o relato de quem usa e as ressalvas. Sem preço e sem comparar preço com outra dica."
    },
    "ficha": {
      "description": "Opcional. Até duas linhas de rótulo e valor, conferidas na página do produto.",
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rotulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "valor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 28
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "rotulo",
          "valor"
        ],
        "additionalProperties": false
      }
    },
    "imagem": {
      "description": "Opcional. Sem foto, o site mostra o desenho da categoria.",
      "type": "object",
      "properties": {
        "arquivo": {
          "type": "string",
          "pattern": "^acessorios\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.webp$"
        },
        "fonte_url": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^https?:\\/\\/"
            },
            {
              "pattern": "^(?![^#]*[?&](?:utm_[^=&#]*|tag|ref|matt_[^=&#]*|partner_id)=)"
            },
            {
              "pattern": "^(?!https?:\\/\\/(?:amzn\\.to|a\\.co|shope\\.ee|s\\.shopee\\.com\\.br)(?:[/?#:]|$))(?!https?:\\/\\/(?:www\\.)?mercadolivre\\.com\\/sec\\/)"
            },
            {
              "pattern": "^(?!https?:\\/\\/(?:[^/?#]*\\.)?magazinevoce\\.com\\.br(?:[/?#:]|$))"
            }
          ]
        }
      },
      "required": [
        "arquivo",
        "fonte_url"
      ],
      "additionalProperties": false
    },
    "relatos": {
      "description": "Opcional. De uma a três conversas do Reddit em que a dica se apoia; o subreddit do texto é o da URL. A fonte do relato vai aqui, e o resumo não abre frase com \"No r/...\".",
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^https?:\\/\\/"
              },
              {
                "pattern": "^(?![^#]*[?&](?:utm_[^=&#]*|tag|ref|matt_[^=&#]*|partner_id)=)"
              },
              {
                "pattern": "^(?!https?:\\/\\/(?:amzn\\.to|a\\.co|shope\\.ee|s\\.shopee\\.com\\.br)(?:[/?#:]|$))(?!https?:\\/\\/(?:www\\.)?mercadolivre\\.com\\/sec\\/)"
              },
              {
                "pattern": "^(?!https?:\\/\\/(?:[^/?#]*\\.)?magazinevoce\\.com\\.br(?:[/?#:]|$))"
              },
              {
                "pattern": "^https:\\/\\/www\\.reddit\\.com\\/r\\/[A-Za-z0-9_]+\\/comments\\/[a-z0-9]+(?:\\/[^/?#]+)?\\/?$"
              }
            ]
          },
          "subreddit": {
            "type": "string",
            "pattern": "^r\\/[A-Za-z0-9_]+$"
          }
        },
        "required": [
          "url",
          "subreddit"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "anyOf": [
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "^https?:\\/\\/"
                  },
                  {
                    "pattern": "^(?![^#]*[?&](?:utm_[^=&#]*|tag|ref|matt_[^=&#]*|partner_id)=)"
                  },
                  {
                    "pattern": "^(?!https?:\\/\\/(?:amzn\\.to|a\\.co|shope\\.ee|s\\.shopee\\.com\\.br)(?:[/?#:]|$))(?!https?:\\/\\/(?:www\\.)?mercadolivre\\.com\\/sec\\/)"
                  },
                  {
                    "pattern": "^(?!https?:\\/\\/(?:[^/?#]*\\.)?magazinevoce\\.com\\.br(?:[/?#:]|$))"
                  }
                ]
              },
              "rotulo": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "url",
              "rotulo"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "atualizado_em": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "marca",
    "modelo",
    "slug",
    "categoria",
    "resumo",
    "links",
    "atualizado_em"
  ],
  "additionalProperties": false
}
