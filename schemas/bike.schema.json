{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catraca.bike/schemas/bike.schema.json",
  "title": "Bike Catraca",
  "type": "object",
  "properties": {
    "marca": {
      "type": "string",
      "minLength": 1
    },
    "modelo": {
      "type": "string",
      "minLength": 1
    },
    "ano": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "mtb",
        "urbana",
        "speed",
        "gravel",
        "ebike",
        "infantil"
      ]
    },
    "url_fabricante": {
      "anyOf": [
        {
          "type": "string",
          "allOf": [
            {
              "pattern": "^https?:\\/\\/"
            },
            {
              "pattern": "^(?![^#]*[?&](?:utm_[^=&#]*|tag|ref|matt_[^=&#]*|partner_id)=)"
            },
            {
              "pattern": "^(?!https?:\\/\\/(?:amzn\\.to|a\\.co|shope\\.ee|s\\.shopee\\.com\\.br)(?:[/?#:]|$))(?!https?:\\/\\/(?:www\\.)?mercadolivre\\.com\\/sec\\/)"
            },
            {
              "pattern": "^(?!https?:\\/\\/(?:[^/?#]*\\.)?magazinevoce\\.com\\.br(?:[/?#:]|$))"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "preco_sugerido_brl": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "atualizado_em": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "quadro": {
      "type": "object",
      "properties": {
        "material": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tamanhos": {
          "anyOf": [
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "aro": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:\\d{1,2}(?:\\.\\d)?|700c)(?:\\/(?:\\d{1,2}(?:\\.\\d)?|700c))?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "suspensao": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "rigida",
                "hardtail",
                "full"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "curso_mm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "material",
        "tamanhos",
        "aro",
        "suspensao",
        "curso_mm"
      ],
      "additionalProperties": false
    },
    "componentes": {
      "type": "object",
      "properties": {
        "grupo": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "velocidades": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "tipo_freio": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "peso_kg": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "grupo",
        "velocidades",
        "tipo_freio",
        "peso_kg"
      ],
      "additionalProperties": false
    },
    "ebike": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "motor_tipo": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "potencia_w": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "torque_nm": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "bateria_wh": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "autonomia_declarada_km": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "acelerador": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "assistencia_so_com_pedal": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "vel_max_kmh": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Velocidade máxima com motor declarada pelo fabricante, em km/h: a maior entre acelerador e assistência. É a velocidade máxima de fabricação da Resolução Contran 996/2023. Se a fonte só der a velocidade da assistência numa bike com acelerador, use null."
            },
            "largura_cm": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "entre_eixos_cm": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "motor_tipo",
            "potencia_w",
            "torque_nm",
            "bateria_wh",
            "autonomia_declarada_km",
            "acelerador",
            "assistencia_so_com_pedal",
            "vel_max_kmh",
            "largura_cm",
            "entre_eixos_cm"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "fontes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^https?:\\/\\/"
              },
              {
                "pattern": "^(?![^#]*[?&](?:utm_[^=&#]*|tag|ref|matt_[^=&#]*|partner_id)=)"
              },
              {
                "pattern": "^(?!https?:\\/\\/(?:amzn\\.to|a\\.co|shope\\.ee|s\\.shopee\\.com\\.br)(?:[/?#:]|$))(?!https?:\\/\\/(?:www\\.)?mercadolivre\\.com\\/sec\\/)"
              },
              {
                "pattern": "^(?!https?:\\/\\/(?:[^/?#]*\\.)?magazinevoce\\.com\\.br(?:[/?#:]|$))"
              }
            ]
          },
          "tipo": {
            "type": "string",
            "enum": [
              "fabricante",
              "loja",
              "review"
            ]
          },
          "acessado_em": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "url",
          "tipo",
          "acessado_em"
        ],
        "additionalProperties": false
      }
    },
    "imagem": {
      "description": "Opcional. Sem foto, o site mostra a silhueta da categoria.",
      "type": "object",
      "properties": {
        "arquivo": {
          "type": "string",
          "pattern": "^[a-z0-9]+\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.webp$"
        },
        "fonte_url": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^https?:\\/\\/"
            },
            {
              "pattern": "^(?![^#]*[?&](?:utm_[^=&#]*|tag|ref|matt_[^=&#]*|partner_id)=)"
            },
            {
              "pattern": "^(?!https?:\\/\\/(?:amzn\\.to|a\\.co|shope\\.ee|s\\.shopee\\.com\\.br)(?:[/?#:]|$))(?!https?:\\/\\/(?:www\\.)?mercadolivre\\.com\\/sec\\/)"
            },
            {
              "pattern": "^(?!https?:\\/\\/(?:[^/?#]*\\.)?magazinevoce\\.com\\.br(?:[/?#:]|$))"
            }
          ]
        }
      },
      "required": [
        "arquivo",
        "fonte_url"
      ],
      "additionalProperties": false
    },
    "links_compra": {
      "description": "Opcional. Links de loja para o botão de compra, com a URL limpa do produto.",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^https?:\\/\\/"
              },
              {
                "pattern": "^(?![^#]*[?&](?:utm_[^=&#]*|tag|ref|matt_[^=&#]*|partner_id)=)"
              },
              {
                "pattern": "^(?!https?:\\/\\/(?:amzn\\.to|a\\.co|shope\\.ee|s\\.shopee\\.com\\.br)(?:[/?#:]|$))(?!https?:\\/\\/(?:www\\.)?mercadolivre\\.com\\/sec\\/)"
              },
              {
                "pattern": "^(?!https?:\\/\\/(?:[^/?#]*\\.)?magazinevoce\\.com\\.br(?:[/?#:]|$))"
              }
            ]
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "marca",
    "modelo",
    "ano",
    "slug",
    "categoria",
    "url_fabricante",
    "preco_sugerido_brl",
    "atualizado_em",
    "quadro",
    "componentes",
    "ebike",
    "fontes"
  ],
  "additionalProperties": false
}
